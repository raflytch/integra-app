# Copy to /opt/integra/.env on the VPS and fill in real values. Never commit the copy.

# Public domain served by Caddy (DNS A records for it and www must point to the VPS).
DOMAIN=integraa.site

# Images published by the CI/CD workflow. IMAGE_TAG is overridden on each deploy.
IMAGE_PREFIX=ghcr.io/raflytch/integra-app
IMAGE_TAG=latest

# PostgreSQL. Use a URL-safe password: `openssl rand -hex 24`.
POSTGRES_DB=integra
POSTGRES_USER=integra
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# API secrets. DATABASE_URL, WEB_ORIGIN, PORT, and TRUST_PROXY_HOPS are set in docker-compose.yml.
# `openssl rand -base64 48`
JWT_SECRET=replace-with-at-least-32-random-characters
# `openssl rand -base64 32` (must stay stable: it decrypts stored TOTP secrets)
TOTP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Any OpenAI-compatible provider.
LLM_API_KEY=sk-replace-me
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=3
SIMILARITY_THRESHOLD=0.65
