DATABASE_URL="postgresql://postgres:password@localhost:5433/app"
PORT=3001

# Next.js origin allowed by CORS.
WEB_ORIGIN="http://localhost:3000"

# Session signing secret, at least 32 characters (used by M-11).
JWT_SECRET="replace-with-at-least-32-random-characters"

# AES-256 key for TOTP secrets: `openssl rand -base64 32`.
TOTP_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# Any OpenAI-compatible provider; defaults target DeepSeek V4 Flash via SumoPod.
LLM_API_KEY="sk-replace-me"
LLM_BASE_URL="https://ai.sumopod.com/v1"
LLM_MODEL="deepseek-v4-flash"
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=3

# Uji Bukan Salinan: minimum TF-IDF cosine similarity (0..1) to flag a claim pair.
# Calibrated with `npm run eval:similarity`: demo template claims reach ~0.56, clones ~0.74+.
SIMILARITY_THRESHOLD=0.65
